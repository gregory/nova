{
  "name": "@nova/qrcrawler-svc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local":"wrangler d1 migrations apply qrcrawler-db --local --persist-to .wrangler/state",
    "db:reset": "wrangler d1 execute qrcrawler-db --local --command \"DROP TABLE IF EXISTS crawl_results; DROP TABLE IF EXISTS crawl_jobs;\""
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.15"
  },
  "devDependencies": {
    "wrangler": "4.47.0"
  }
}
